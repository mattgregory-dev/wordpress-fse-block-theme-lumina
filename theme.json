{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "body",       "name": "Body",       "color": "#374151" },
        { "slug": "black",      "name": "Black",      "color": "#000000" },
        { "slug": "light-sage", "name": "Light Sage", "color": "#ebf7f6" },
        { "slug": "white",      "name": "White",      "color": "#ffffff" },
        { "slug": "sage",       "name": "Sage",       "color": "#c3ddd5" },
        { "slug": "mist",       "name": "Mist",       "color": "#d6e3e5" },
        { "slug": "forest",     "name": "Forest",     "color": "#1f2f2a" },
        { "slug": "fog",        "name": "Fog",        "color": "#e5e7eb" },
        { "slug": "muted",      "name": "Muted",      "color": "#6b7280" },
        { "slug": "blue",       "name": "Blue",       "color": "#3b82f6" },
        { "slug": "dark-blue",  "name": "Dark Blue",  "color": "#1d4ed8" },
        { "slug": "error",      "name": "Error",      "color": "#a44b4b" }
      ]
    },
    "shadow": {
      "defaultShadow": false,
      "presets": [
        { "slug": "soft",     "name": "Soft",     "shadow": "0 4px 12px rgba(17, 17, 17, 0.06)" },
        { "slug": "lifted",   "name": "Lifted",   "shadow": "0 10px 30px rgba(17, 17, 17, 0.10)" },
        { "slug": "dramatic", "name": "Dramatic", "shadow": "0 24px 60px rgba(17, 17, 17, 0.18)" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "lineHeight": true,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "Lato, -apple-system, BlinkMacSystemFont, sans-serif",
          "fontFace": [
            { "fontFamily": "Lato", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/lato-300.woff2"] },
            { "fontFamily": "Lato", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/lato-400.woff2"] },
            { "fontFamily": "Lato", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./assets/fonts/lato-400-italic.woff2"] },
            { "fontFamily": "Lato", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/lato-700.woff2"] }
          ]
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "Marcellus, Georgia, serif",
          "fontFace": [
            { "fontFamily": "Marcellus", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/marcellus-400.woff2"] }
          ]
        },
        { "slug": "mono", "name": "Mono", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace" }
      ],
      "fontSizes": [
        { "slug": "xx-small", "name": "XX Small", "size": "0.75rem",   "fluid": false },
        { "slug": "x-small",  "name": "X Small",  "size": "0.875rem",  "fluid": false },
        { "slug": "small",    "name": "Small",    "size": "1rem",      "fluid": false },
        { "slug": "medium",   "name": "Medium",   "size": "1.125rem",  "fluid": false },
        { "slug": "large",    "name": "Large",    "size": "1.3125rem", "fluid": false },
        { "slug": "x-large",  "name": "X Large",  "size": "1.625rem",  "fluid": false },
        { "slug": "xx-large", "name": "XX Large", "size": "2.625rem",  "fluid": { "min": "2rem", "max": "2.625rem" } },
        { "slug": "huge",     "name": "Huge",     "size": "3.25rem",   "fluid": { "min": "2.5rem", "max": "3.25rem" } }
      ]
    },
    "layout": {
      "contentSize": "1120px",
      "wideSize": "1168px"
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "css": "img{max-width:100%;height:auto}.has-border-color{border-style:solid}",
    "color": {
      "background": "var(--wp--preset--color--light-sage)",
      "text": "var(--wp--preset--color--body)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "letterSpacing": "0.01em"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "1.25rem",
        "right": "1.25rem"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400",
          "lineHeight": "1.15"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.1" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--blue)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--dark-blue)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--black)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": { "width": "2px", "style": "solid", "color": "var(--wp--preset--color--black)", "radius": "5px" },
        "spacing": {
          "padding": { "top": "0.75em", "bottom": "0.75em", "left": "1.5em", "right": "1.5em" }
        },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500", "textDecoration": "none" },
        ":hover": { "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--black)" } },
        ":focus": { "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--black)" } },
        ":active": { "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--black)" } }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "400"
        }
      },
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--body)" },
            ":hover": { "color": { "text": "var(--wp--preset--color--dark-blue)" } }
          }
        }
      },
      "core/post-excerpt": {
        "color": { "text": "var(--wp--preset--color--muted)" }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--fog)" }
      },
      "core/quote": {
        "border": {
          "left": { "color": "var(--wp--preset--color--blue)", "width": "3px" }
        },
        "spacing": { "padding": { "left": "1.5rem" } },
        "typography": { "fontStyle": "italic" }
      },
      "core/pullquote": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--x-large)" }
      },
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)", "textTransform": "uppercase", "letterSpacing": "0.05em" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-full-width", "title": "Full Width Page", "postTypes": ["page"] }
  ]
}
