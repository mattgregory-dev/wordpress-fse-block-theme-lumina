{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "no-descending-specificity": null,
    "no-empty-source": null,
    "scss/operator-no-newline-after": null,
    "scss/at-rule-no-unknown": [true, {
      "ignoreAtRules": ["tailwind", "apply", "variants", "responsive", "screen", "layer", "config"]
    }],
    "selector-class-pattern": ["^[a-z][a-z0-9_-]*$", {
      "message": "Class names must be lowercase, may contain digits, hyphens, or underscores (underscores accommodate WordPress core classes like .current_page_item)."
    }]
  },
  "ignoreFiles": [
    "dist/**",
    "node_modules/**",
    "src/public/**"
  ]
}
